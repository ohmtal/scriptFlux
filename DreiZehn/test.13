print "--- Run Engine-Test ---"

# functions
fn calc faktor
    result = (faktor * 10) + 5
    print result
end

# loop
for i 1 3
    print "#" i
    calc i
end

# concat
for i 1 3
   print (concat "i is: " i)
end

# break
for i 0 10
   print (concat "break at " (i - 5) "=>" i)
   if (i == 5) break
end

fn scriptAdd a b
    return (a+b)
end

print (scriptAdd 5 6 )

